<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>dev.dimster</groupId>
		<artifactId>dimster</artifactId>
		<version>0.5.0</version>
		<relativePath>..</relativePath>
	</parent>

	<artifactId>dimster-kafka-4.2.0</artifactId>
	<name>Dimster Kafka 4.2.0 Impl</name>
	<packaging>jar</packaging>

	<!--
	Per-version SPI implementation: binds dimster-spi to kafka-clients 4.2.0.

	Why this module exists:
	dimster-core depends only on dimster-spi (no kafka-clients dep). This module
	provides concrete RawConsumer / RawShareConsumer / RawProducer / RawAdmin
	implementations that delegate to the real Kafka 4.2.0 client classes. At
	runtime, java.util.ServiceLoader picks up the META-INF/services entry shipped
	in src/main/resources and binds KafkaClientFactoryV4_2_0 as the active factory.

	One impl module per supported Kafka client version. Exactly one such module
	is bundled into each per-version package tarball (package-4.2.0, package-3.7,
	...), so ServiceLoader finds exactly one factory at runtime.
	-->

	<properties>
		<kafka.version>4.2.0</kafka.version>
	</properties>

	<dependencies>
		<dependency>
			<groupId>dev.dimster</groupId>
			<artifactId>dimster-spi</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>org.apache.kafka</groupId>
			<artifactId>kafka-clients</artifactId>
			<version>${kafka.version}</version>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<version>2.10</version>
				<executions>
					<execution>
						<id>build-classpath</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>build-classpath</goal>
						</goals>
						<configuration>
							<outputFile>target/classpath.txt</outputFile>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
