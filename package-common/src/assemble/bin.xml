<assembly
	xmlns="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.2"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.2 http://maven.apache.org/xsd/assembly-1.1.2.xsd">
	<id>bin</id>
	<formats>
		<format>tar.gz</format>
	</formats>
	<includeBaseDirectory>true</includeBaseDirectory>

	<!--
	No <moduleSets> on purpose. The original (pre-multi-version) descriptor used
	<useAllReactorProjects>true</useAllReactorProjects> to grab every reactor
	module's jar. That worked when there was only one Kafka client impl in the
	reactor, but with per-flavor impl modules (dimster-kafka-3.x,
	dimster-kafka-4.2.0, ...) it would put more than one KafkaClientFactory
	implementation on the runtime classpath. KafkaSpi.factory() then errors out
	with "Multiple implementations found". Instead, each per-flavor package
	module declares its dimster-kafka-X impl as a direct dep, and the dependencySet
	below pulls in only that one (plus its transitive deps).
	-->

	<fileSets>
		<fileSet>
			<directory>${basedir}/../workloads</directory>
		</fileSet>
		<fileSet>
			<directory>${basedir}/../payload</directory>
		</fileSet>
		<fileSet>
			<directory>${basedir}/../bin</directory>
			<fileMode>755</fileMode>
		</fileSet>

		<fileSet>
			<directory>${basedir}/../kafka-configs</directory>
			<outputDirectory>kafka-configs</outputDirectory>
			<includes>
				<include>*.yaml</include>
			</includes>
		</fileSet>
	</fileSets>

	<files>
		<file>
			<source>${basedir}/../README.md</source>
			<outputDirectory>.</outputDirectory>
			<fileMode>644</fileMode>
		</file>
		<file>
			<source>${basedir}/../LICENSE</source>
			<destName>LICENSE</destName>
			<outputDirectory>.</outputDirectory>
			<fileMode>644</fileMode>
		</file>
	</files>

	<dependencySets>
		<dependencySet>
			<outputDirectory>lib</outputDirectory>
			<unpack>false</unpack>
			<!-- runtime, not compile: kafka-clients declares its compression
			     codecs (lz4-java, zstd-jni, snappy-java) as runtime
			     dependencies, and without them producers fail with
			     NoClassDefFoundError for any compression.type but none. -->
			<scope>runtime</scope>
			<useProjectArtifact>false</useProjectArtifact>
			<outputFileNameMapping>${artifact.groupId}-${artifact.artifactId}-${artifact.version}${dashClassifier?}.${artifact.extension}</outputFileNameMapping>
		</dependencySet>
	</dependencySets>
</assembly>
